{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Bulk assignment stats",
  "properties": {
    "filter": {
      "$ref": "#/$defs/filter"
    },
    "group_by": {
      "type": "string",
      "enum": [
        "assignment",
        "user",
        "user_phase"
      ]
    }
  },
  "required": [
    "filter",
    "group_by"
  ],
  "additionalProperties": true,
  "$defs": {
    "filter": {
      "title": "Filter query",
      "description": "The filters to search for the annotations by",
      "type": "object",
      "properties": {
        "groups": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "h_userids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "assignment_ids": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_uri": {
          "type": "string",
          "description": "The assignment's document URI. Identifies the (groups, document) checkpoint whose reveals delimit the grading phases, so it is required for group_by user_phase. Only supported when assignment_ids identifies a single assignment."
        },
        "due_date": {
          "type": "string",
          "format": "date-time",
          "description": "Upper bound on annotation `created`, applied to all counts."
        }
      },
      "required": [
        "groups"
      ],
      "additionalProperties": false
    },
    "nonEmptyStringArray": {
      "type": [
        "array"
      ],
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "title": "user_phase requires a document",
      "description": "Grading phases are delimited by the checkpoint reveals of a (group, document) pair, so without a document there is nothing to divide them by.",
      "if": {
        "properties": {
          "group_by": {
            "const": "user_phase"
          }
        },
        "required": [
          "group_by"
        ]
      },
      "then": {
        "properties": {
          "filter": {
            "required": [
              "document_uri"
            ]
          }
        },
        "required": [
          "filter"
        ]
      }
    },
    {
      "title": "document_uri identifies exactly one assignment",
      "description": "A checkpoint's reveal_date is only meaningful for a single (group, document) pair, not a mix of assignments.",
      "if": {
        "properties": {
          "filter": {
            "required": [
              "document_uri"
            ]
          }
        },
        "required": [
          "filter"
        ]
      },
      "then": {
        "properties": {
          "filter": {
            "properties": {
              "assignment_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "assignment_ids"
            ]
          }
        },
        "required": [
          "filter"
        ]
      }
    }
  ]
}
