{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Bulk assignment stats",
  "properties": {
    "filter": {
      "$ref": "#/$defs/filter"
    },
    "group_by": {
      "type": "string",
      "enum": [
        "assignment",
        "user"
      ]
    }
  },
  "required": [
    "filter",
    "group_by"
  ],
  "additionalProperties": true,
  "$defs": {
    "filter": {
      "title": "Filter query",
      "description": "The filters to search for the annotations by",
      "type": "object",
      "properties": {
        "groups": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "h_userids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "assignment_ids": {
          "anyOf": [
            {
              "ref": "#/$defs/nonEmptyStringArray"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_uri": {
          "type": "string",
          "description": "The assignment's document URI. When given, results also include the checkpoint_* breakdown for this (groups, document) checkpoint. Only supported when assignment_ids identifies a single assignment."
        },
        "due_date": {
          "type": "string",
          "format": "date-time",
          "description": "Upper bound on annotation `created`, applied to all counts."
        }
      },
      "required": [
        "groups"
      ],
      "additionalProperties": false
    },
    "nonEmptyStringArray": {
      "type": [
        "array"
      ],
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
